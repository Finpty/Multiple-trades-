// ─────────────────────────────────────────────────────────────────────────────
// TRADE ONE — canonical PostgreSQL schema
//
// Conventions
//  • Tables are snake_case (@@map); columns stay camelCase (quoted identifiers).
//  • Primary keys are uuid (gen_random_uuid()).
//  • Every tenant-owned table carries `businessId` and is protected by
//    PostgreSQL Row Level Security (see prisma/migrations/*_rls).
//  • Money is stored as integer cents (`*Cents`). Rates are Decimal.
//  • Structured configuration lives in jsonb columns; their TypeScript shapes
//    are declared in src/lib/schemas/* and validated with zod at the boundary.
//  • Important business records are soft-deleted (`deletedAt`) or archived
//    through explicit status enums rather than physically removed.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

